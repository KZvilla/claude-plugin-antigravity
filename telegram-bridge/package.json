{
  "name": "antigravity-telegram-bridge",
  "version": "1.0.0",
  "description": "Zero-cost Telegram bot bridge for Antigravity CLI and Claude Code over CGNAT",
  "type": "module",
  "main": "bot.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node bot.js",
    "test": "node test-bridge.js",
    "daemon:check": "node daemon.mjs check",
    "daemon": "node daemon.mjs status",
    "daemon:install": "node daemon.mjs install",
    "daemon:uninstall": "node daemon.mjs uninstall",
    "daemon:logs": "node daemon.mjs logs",
    "daemon:start": "node daemon.mjs start",
    "daemon:stop": "node daemon.mjs stop"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.35.0"
  },
  "keywords": [
    "telegram-bot",
    "antigravity",
    "claude-code",
    "cgnat",
    "long-polling"
  ],
  "author": "KZvilla",
  "license": "MIT"
}
