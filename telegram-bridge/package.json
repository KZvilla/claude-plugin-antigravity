{
  "name": "antigravity-telegram-bridge",
  "version": "1.0.0",
  "description": "Zero-cost Telegram bot bridge for Antigravity CLI and Claude Code over CGNAT",
  "type": "module",
  "main": "bot.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node bot.js",
    "test": "node test-bridge.js",
    "daemon": "powershell -NoProfile -ExecutionPolicy Bypass -File daemon.ps1 status",
    "daemon:install": "powershell -NoProfile -ExecutionPolicy Bypass -File daemon.ps1 install",
    "daemon:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File daemon.ps1 uninstall",
    "daemon:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File daemon.ps1 logs"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.35.0"
  },
  "keywords": [
    "telegram-bot",
    "antigravity",
    "claude-code",
    "cgnat",
    "long-polling"
  ],
  "author": "KZvilla",
  "license": "MIT"
}
